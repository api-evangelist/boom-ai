{
  "opencollection": "1.0.0",
  "info": {
    "name": "Boom CDP Custom Objects HTTP credentials API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "HTTP credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List HTTP credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.useboom.ai/api/v1/http-credentials"
          },
          "docs": "List the reusable HTTP credentials configured for your organization. Reference a credential's id to authenticate an HTTP Request journey node. Secrets are never returned."
        }
      ]
    }
  ],
  "bundled": true
}